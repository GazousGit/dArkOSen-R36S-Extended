#!/bin/bash

# =======================================================
# Launch reminder  (dArkOSen Extended, see Shortcuts.sh)
#
# perfmax, the script dArkOSen runs before every game,
# calls this right before the emulator starts. It prints
# the key combinations of that emulator (quit, menu, save
# states...) on the console for up to DELAY seconds (10 by
# default); A (or B or Start) goes on at once.
#
# The text comes from <key>.txt, looked up first in
# <roms>/shortcuts/ (your own versions), then in
# /usr/share/dArkOSen-Extended/shortcuts/ (built-in).
# Keys tried, in this order:
#   <launcher>.<emulator>   e.g. n64.standalone-Rice
#   retroarch | retrorun    for those two, whatever the system
#   <launcher>              e.g. n64, ppsspp, drastic, saturn
#   standalone              when the launcher uses dArkOSen's
#                           exit daemon (SELECT + START)
# While the hotkey layout is "darkosen" (LAYOUT in
# shortcuts.conf), <key>.darkosen.txt is tried before
# <key>.txt in each folder. No file, no reminder.
#
# On screen, the names A B X Y take the colours of the
# R36S buttons and UP DOWN LEFT RIGHT become arrows.
#
#   launch-reminder           normal use (from perfmax)
#   launch-reminder --which   print "<keys tried> -> <file>"
# =======================================================
# MIT License - same terms as dArkOSen.

MODE="${1:-}"
CONF="${SHORTCUTS_CONF:-/home/ark/.config/shortcuts.conf}"
DIRS="${SHORTCUTS_DIRS:-/roms/shortcuts /roms2/shortcuts /usr/share/dArkOSen-Extended/shortcuts}"
BIN="${SHORTCUTS_BIN:-/usr/local/bin}"
TTY="${SHORTCUTS_TTY:-/dev/tty1}"
PYTHON="${SHORTCUTS_PYTHON:-python3}"
REMINDER=1; DELAY=10; LAYOUT=darkosen
[ -f "$CONF" ] && . "$CONF"
[[ "$DELAY" =~ ^[0-9]+$ ]] || DELAY=10
[ "$LAYOUT" = universal ] || LAYOUT=darkosen
if [ "$MODE" != "--which" ]; then
    [ "$REMINDER" = 1 ] || exit 0
    [[ "$(tty 2>/dev/null)" == *pts* ]] && exit 0      # not when a game is started over SSH
fi

# EmulationStation runs, through a shell,
#   sudo perfmax GOVERNOR ROM; nice -n -19 LAUNCHER [EMULATOR] [CORE] ROM; sudo perfnorm
# That shell is one of our ancestors: its command line tells which emulator comes next.
cmd="${LAUNCH_CMD:-}"; pid=$$
while [ -z "$cmd" ]; do
    pid=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$pid/status" 2>/dev/null)
    [ -n "$pid" ] && [ "$pid" -gt 1 ] || break
    c=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
    case "$c" in *perfmax*\;*) cmd=$c ;; esac
done
[ -n "$cmd" ] || exit 0
launch=${cmd#*;}; launch=${launch%%;*}
set -f
# shellcheck disable=SC2086
set -- $launch
set +f
while [ $# -gt 0 ]; do case "$1" in nice|-n|-19|sudo) shift ;; *) break ;; esac; done
launcher=$(basename "${1:-}" .sh); emu=${2:-}
[[ "$launcher" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 0
[[ "$emu" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || emu=""      # not an emulator name (an option, the rom)

case "$launcher" in
    retroarch|retroarch32) keys="retroarch" ;;
    retrorun|retrorun32)   keys="retrorun" ;;
    *)  case "$emu" in
            retroarch|retroarch32) keys="$launcher.$emu retroarch" ;;
            retrorun|retrorun32)   keys="$launcher.$emu retrorun" ;;
            "")                    keys="$launcher" ;;
            *)                     keys="$launcher.$emu $launcher" ;;
        esac
        case "$emu" in
            retroarch*|retrorun*) ;;
            *) grep -qs KILLIT "$BIN/$launcher.sh" "$BIN/$launcher" && keys="$keys standalone" ;;
        esac ;;
esac
file=""
for k in $keys; do
    lay=$LAYOUT      # dArkOSen's own retrorun build keeps its keys; the hotkeys build carries this string
    [ "$k" = retrorun ] && [ "$lay" = universal ] && ! grep -qs retrorun_hotkey_menu "$BIN/retrorun" "$BIN/retrorun32" && lay=darkosen
    for d in $DIRS; do
        [ "$lay" = darkosen ] && [ -f "$d/$k.darkosen.txt" ] && { file="$d/$k.darkosen.txt"; break 2; }
        [ -f "$d/$k.txt" ] && { file="$d/$k.txt"; break 2; }
    done
done
if [ "$MODE" = "--which" ]; then echo "$keys -> ${file:-none}"; exit 0; fi
[ -n "$file" ] || exit 0

# Up to $1 seconds, or until A, B or Start is pressed on a game pad (R36S: A = BTN_EAST,
# Start = BTN_TRIGGER_HAPPY2). Read with python3-evdev, which dArkOSen's exit daemon uses;
# without it or without a pad, just wait.
Wait_Button() {
    local rc=0
    "$PYTHON" - "$1" 2>/dev/null <<'EOF' || rc=$?
import select, sys, time
try:
    import evdev
    from evdev import ecodes
except Exception:
    sys.exit(3)
wanted = {ecodes.BTN_EAST, ecodes.BTN_SOUTH, ecodes.BTN_START, ecodes.BTN_TRIGGER_HAPPY2}
fds = {}
for path in evdev.list_devices():
    try:
        d = evdev.InputDevice(path)
        if wanted & set(d.capabilities().get(ecodes.EV_KEY, [])):
            fds[d.fd] = d
        else:
            d.close()
    except OSError:
        pass
if not fds:
    sys.exit(3)
end = time.monotonic() + float(sys.argv[1])
while True:
    left = end - time.monotonic()
    if left <= 0:
        sys.exit(1)
    if not fds:                        # pad unplugged
        time.sleep(left)
        sys.exit(1)
    ready, _, _ = select.select(list(fds), [], [], left)
    for fd in ready:
        try:
            for e in fds[fd].read():
                if e.type == ecodes.EV_KEY and e.value == 1 and e.code in wanted:
                    sys.exit(0)
        except OSError:
            del fds[fd]
EOF
    [ "$rc" -le 1 ] || sleep "$1"
}

# Button names in the colours of the R36S (A red, B yellow, X blue, Y green) and the
# directions as arrows, padded to the width of the word so the columns stay aligned. The
# arrows are in the Terminus console fonts (U+2190..2193); the console is in UTF-8 mode.
# Whole words only: "A" in "A ... screenshot" or "SELECT + A", not the a of "game".
E=$'\033'
Decorate() {
    local s=$1 w='[^A-Za-z0-9]' p
    p="s/(^|$w)A($w|\$)/\1${E}[1;31mA${E}[0m\2/g; s/(^|$w)B($w|\$)/\1${E}[1;33mB${E}[0m\2/g;"
    p="$p s/(^|$w)X($w|\$)/\1${E}[1;34mX${E}[0m\2/g; s/(^|$w)Y($w|\$)/\1${E}[1;32mY${E}[0m\2/g;"
    p="$p s/(^|$w)UP($w|\$)/\1\xe2\x86\x91 \2/g; s/(^|$w)DOWN($w|\$)/\1\xe2\x86\x93   \2/g;"
    p="$p s/(^|$w)LEFT($w|\$)/\1\xe2\x86\x90   \2/g; s/(^|$w)RIGHT($w|\$)/\1\xe2\x86\x92    \2/g"
    sed -E -e "$p" -e "$p" <<<"$s"          # twice: "A/B" shares its separator between two matches
}

# First line = title; lines starting with # are notes for whoever edits the file.
# 40 columns x 15 rows on 640x480: the title and 11 lines, the prompt on the last row.
setfont -C "$TTY" /usr/share/consolefonts/Lat7-TerminusBold32x16.psf.gz 2>/dev/null
{
    printf '\033c\033[?25l\n'
    n=0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}; line=${line#$'\xef\xbb\xbf'}       # files saved by Windows editors
        case "$line" in \#*) continue ;; esac
        n=$((n + 1)); [ "$n" -le 12 ] || break
        if [ "$n" = 1 ]; then printf ' \033[1;33m%s\033[0m\n\n' "$line"; else printf ' %s\n' "$(Decorate "$line")"; fi
    done < "$file"
    [ "$DELAY" -eq 0 ] || printf '\033[15;1H \033[1;36mPress \033[1;31mA\033[1;36m to continue\033[0m'
} >> "$TTY" 2>/dev/null
[ "$DELAY" -eq 0 ] || Wait_Button "$DELAY"
printf '\033c' >> "$TTY" 2>/dev/null
setfont -C "$TTY" 2>/dev/null
exit 0
